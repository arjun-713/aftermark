{
  "name": "agent-quality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "npm run dev -w @agent-quality/web",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:python": "PYTHONPATH=sdk/python/src python3 -m unittest discover -s tests/python -v",
    "build": "npm run build -w @agent-quality/web",
    "aq": "tsx packages/cli/src/index.ts",
    "check:release": "tsx scripts/release-gates.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@octokit/auth-app": "8.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-table": "8.21.3",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "lucide-react": "0.552.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
