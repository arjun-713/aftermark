{
  "name": "agent-quality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "npm run dev -w @agent-quality/web",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:prepare": "node scripts/supabase-local.mjs prepare",
    "supabase:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "supabase:verify": "tsx --env-file=.env.supabase.local scripts/verify-supabase.ts",
    "supabase:verify:hosted": "tsx --env-file=.env.supabase.hosted.local scripts/verify-supabase.ts",
    "dev:supabase": "tsx --env-file=.env.supabase.local scripts/dev.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:samples": "tsx scripts/sample-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:regression": "tsx scripts/test-isolated.ts regression",
    "test:commerce": "tsx scripts/test-isolated.ts commerce",
    "test:operations": "tsx scripts/test-isolated.ts operations",
    "test:e2e": "playwright test",
    "test:python": "PYTHONPATH=sdk/python/src python3 -m unittest discover -s tests/python -v",
    "build": "npm run build -w @agent-quality/web && npm run build -w @agent-quality/cli && npm run build -w @agent-quality/sdk",
    "aq": "tsx packages/cli/src/index.ts",
    "check:release": "tsx scripts/release-gates.ts",
    "calibrate": "tsx scripts/calibration.ts",
    "test:identity": "tsx scripts/test-isolated.ts identity",
    "test:alerts": "tsx scripts/test-isolated.ts alerts",
    "test:storage": "tsx scripts/test-isolated.ts storage",
    "build:services": "node scripts/build-services.mjs",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:load": "tsx scripts/load.ts",
    "test:storage-operations": "tsx scripts/test-isolated.ts storage_ops"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@octokit/auth-app": "8.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-table": "8.21.3",
    "commander": "14.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "lucide-react": "0.552.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
