  "components": [
    {
      "name": "Application primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The compact primary action used on working sheets.",
      "html": "<button type=\"button\" class=\"ds-btn-primary\">Save changes</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:35px;padding:7px 12px;border-radius:6px;font-size:12px;line-height:1.5;font-family:\"Work Sans\",sans-serif;font-weight:500;width:auto;white-space:nowrap;border:1px solid transparent;background:var(--brand-ink,#153d31);color:#fff;border-color:var(--brand-ink,#153d31);cursor:pointer;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,transform 180ms cubic-bezier(.22,1,.36,1)}.ds-btn-primary:hover{background:#265742;border-color:#265742;}.ds-btn-primary:hover:not(:disabled){filter:brightness(.97)}.ds-btn-primary:focus-visible{outline:2px solid #387653;outline-offset:4px;}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:disabled{opacity:.65;cursor:default}.ds-btn-primary>svg{flex:none;transition:transform 220ms cubic-bezier(.22,1,.36,1)}.ds-btn-primary:hover>svg{transform:translate(2px,-2px)}@media(max-width:700px){.ds-btn-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-btn-primary,.ds-btn-primary>svg{transition:none}}"
    },
    {
      "name": "Application secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A bordered secondary action on the white working sheet.",
      "html": "<button type=\"button\" class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:35px;padding:7px 12px;border-radius:6px;font-size:12px;line-height:1.5;font-family:\"Work Sans\",sans-serif;font-weight:500;width:auto;white-space:nowrap;border:1px solid transparent;background:var(--surface,#ffffff);color:var(--text,#24312b);border-color:var(--control,#c5cfc5);cursor:pointer;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,transform 180ms cubic-bezier(.22,1,.36,1)}.ds-btn-secondary:hover{background:#f2f5ef;border-color:#9daf9d;}.ds-btn-secondary:hover:not(:disabled){filter:brightness(.97)}.ds-btn-secondary:focus-visible{outline:2px solid #387653;outline-offset:4px;}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:disabled{opacity:.65;cursor:default}.ds-btn-secondary>svg{flex:none;transition:transform 220ms cubic-bezier(.22,1,.36,1)}.ds-btn-secondary:hover>svg{transform:translate(2px,-2px)}@media(max-width:700px){.ds-btn-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-btn-secondary,.ds-btn-secondary>svg{transition:none}}"
    },
    {
      "name": "Public primary button",
      "kind": "button",
      "refersTo": "button-public-primary",
      "description": "The larger forest-ink workspace action used on public pages.",
      "html": "<a class=\"ds-btn-public\" href=\"/login?mode=signup\">Create your workspace <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></a>",
      "css": ".ds-btn-public{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 19px;border-radius:4px;font-size:14px;line-height:1.4;font-family:\"Work Sans\",sans-serif;font-weight:500;width:auto;white-space:nowrap;border:1px solid transparent;background:var(--brand-ink,#153d31);color:#fff;border-color:var(--brand-ink,#153d31);cursor:pointer;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,transform 180ms cubic-bezier(.22,1,.36,1)}.ds-btn-public:hover{background:var(--brand-ink,#153d31);border-color:#265742;}.ds-btn-public:hover:not(:disabled){filter:brightness(.97)}.ds-btn-public:focus-visible{outline:2px solid #387653;outline-offset:4px;}.ds-btn-public:active{transform:translateY(1px)}.ds-btn-public:disabled{opacity:.65;cursor:default}.ds-btn-public>svg{flex:none;transition:transform 220ms cubic-bezier(.22,1,.36,1)}.ds-btn-public:hover>svg{transform:translate(2px,-2px)}@media(max-width:700px){.ds-btn-public{min-height:48px}}@media(prefers-reduced-motion:reduce){.ds-btn-public,.ds-btn-public>svg{transition:none}}@media(max-width:600px){.ds-btn-public{min-height:44px;font-size:13px}}"
    },
    {
      "name": "Public secondary button",
      "kind": "button",
      "refersTo": "button-public-secondary",
      "description": "A transparent bordered public action, including plan choices.",
      "html": "<a class=\"ds-btn-public-secondary\" href=\"/login\">Start with Trial <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></a>",
      "css": ".ds-btn-public-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 19px;border-radius:4px;font-size:14px;line-height:1.4;font-family:\"Work Sans\",sans-serif;font-weight:500;width:auto;white-space:nowrap;border:1px solid transparent;background:transparent;color:var(--text,#24312b);border-color:var(--control,#c5cfc5);cursor:pointer;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,transform 180ms cubic-bezier(.22,1,.36,1)}.ds-btn-public-secondary:hover{background:transparent;border-color:#9daf9d;}.ds-btn-public-secondary:hover:not(:disabled){filter:brightness(.97)}.ds-btn-public-secondary:focus-visible{outline:2px solid #387653;outline-offset:4px;}.ds-btn-public-secondary:active{transform:translateY(1px)}.ds-btn-public-secondary:disabled{opacity:.65;cursor:default}.ds-btn-public-secondary>svg{flex:none;transition:transform 220ms cubic-bezier(.22,1,.36,1)}.ds-btn-public-secondary:hover>svg{transform:translate(2px,-2px)}@media(max-width:700px){.ds-btn-public-secondary{min-height:48px}}@media(prefers-reduced-motion:reduce){.ds-btn-public-secondary,.ds-btn-public-secondary>svg{transition:none}}"
    },
    {
      "name": "Destructive button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "The existing destructive action variant; retain its actual confirmation behavior in the application.",
      "html": "<button type=\"button\" class=\"ds-btn-danger\">Revoke</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:35px;padding:7px 12px;border-radius:6px;font-size:12px;line-height:1.5;font-family:\"Work Sans\",sans-serif;font-weight:500;width:auto;white-space:nowrap;border:1px solid transparent;background:#a2343b;color:#fff;cursor:pointer;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,transform 180ms cubic-bezier(.22,1,.36,1)}.ds-btn-danger:hover:not(:disabled){filter:brightness(.97)}.ds-btn-danger:focus-visible{outline:2px solid #387653;outline-offset:4px;}.ds-btn-danger:active{transform:translateY(1px)}.ds-btn-danger:disabled{opacity:.65;cursor:default}.ds-btn-danger>svg{flex:none;transition:transform 220ms cubic-bezier(.22,1,.36,1)}.ds-btn-danger:hover>svg{transform:translate(2px,-2px)}@media(max-width:700px){.ds-btn-danger{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-btn-danger,.ds-btn-danger>svg{transition:none}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "The ordinary labeled application field with a visible focus treatment.",
      "html": "<label class=\"ds-field\">Project name<input type=\"text\" placeholder=\"Project name\" /></label>",
      "css": ".ds-field{display:grid;gap:7px;margin-bottom:16px;color:var(--text,#24312b);font:500 14px/1.5 \"Work Sans\",sans-serif}.ds-field>input{width:100%;max-width:100%;min-height:36px;padding:7px 10px;border:1px solid var(--control,#c5cfc5);border-radius:6px;background:var(--surface,#ffffff);color:var(--text,#24312b);caret-color:var(--accent,#28634a);font:400 14px/1.5 \"Work Sans\",sans-serif}.ds-field>input::placeholder{color:#69737c}.ds-field>input:focus-visible{outline:2px solid #387653;outline-offset:4px;}@media(max-width:700px){.ds-field>input{min-height:44px}}"
    },
    {
      "name": "Application navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "The receding workspace navigation and selected destination.",
      "html": "<nav class=\"ds-app-nav\" aria-label=\"Primary navigation\"><a href=\"/app\" class=\"ds-app-nav-item ds-active\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg><span>Overview</span></a><a href=\"/app/runs\" class=\"ds-app-nav-item\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 5h13\"/><path d=\"M13 12h8\"/><path d=\"M13 19h8\"/><path d=\"M3 10a2 2 0 0 0 2 2h3\"/><path d=\"M3 5v12a2 2 0 0 0 2 2h3\"/></svg><span>Runs</span></a></nav>",
      "css": ".ds-app-nav{width:200px;padding:14px;background:var(--ground,#edf0ec);font:400 14px/1.5 \"Work Sans\",sans-serif}.ds-app-nav-item{display:flex;align-items:center;gap:10px;min-height:38px;padding:7px 12px;margin-bottom:3px;border-radius:6px;color:#58665d;text-decoration:none;transition:background-color 160ms ease,color 160ms ease}.ds-app-nav-item>svg{flex:none}.ds-app-nav-item:hover{background:#e5ebe2;color:var(--text,#24312b);filter:brightness(.97)}.ds-app-nav-item.ds-active{background:var(--active,#e1e7df);color:#233b2c;font-weight:500}.ds-app-nav-item:focus-visible{outline:2px solid #387653;outline-offset:4px;}@media(max-width:700px){.ds-app-nav-item{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-app-nav-item{transition:none}}"
    },
    {
      "name": "Outcome status badges",
      "kind": "chip",
      "refersTo": "badge-unknown",
      "description": "The current unknown, verified, and contradicted badge families; each keeps a text label.",
      "html": "<div class=\"ds-badge-row\"><span class=\"ds-badge ds-unknown\"><span class=\"ds-status-dot\"></span>unknown</span><span class=\"ds-badge ds-verified\"><span class=\"ds-status-dot\"></span>verified</span><span class=\"ds-badge ds-contradicted\"><span class=\"ds-status-dot\"></span>contradicted</span></div>",
      "css": ".ds-badge-row{display:flex;flex-wrap:wrap;gap:8px}.ds-badge{display:inline-flex;align-items:center;gap:5px;flex:none;white-space:nowrap;padding:2px 7px;border-radius:4px;font:500 11px/1.5 \"Work Sans\",sans-serif;text-transform:capitalize;vertical-align:middle}.ds-status-dot{width:4px;height:4px;flex:none;border-radius:50%;background:currentColor}.ds-unknown{color:#7c5b18;background:#f5edda}.ds-verified{color:#22573b;background:#e8f1e3}.ds-contradicted{color:#94323e;background:#f9e9e9}"
    },
    {
      "name": "Documentation contents",
      "kind": "nav",
      "refersTo": "docs-navigation-item",
      "description": "The reading navigation with a current section and stable anchor destinations.",
      "html": "<nav class=\"ds-docs-nav\" aria-label=\"Documentation contents\"><p class=\"ds-docs-title\">On this page</p><a class=\"ds-docs-item\" href=\"#start\" aria-current=\"location\"><span>Get started</span><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14\"/><path d=\"m19 12-7 7-7-7\"/></svg></a><a class=\"ds-docs-item\" href=\"#outcomes\">Expected outcomes</a><a class=\"ds-docs-item\" href=\"#verifiers\">Verification</a><a class=\"ds-docs-item\" href=\"#reviews\">Human review</a></nav>",
      "css": ".ds-docs-nav{width:200px;padding:16px;background:var(--brand-paper,#edf2e8);font:400 14px/1.5 \"Work Sans\",sans-serif}.ds-docs-title{margin:0 0 24px;color:var(--brand-ink,#153d31);font-size:13px;font-weight:500}.ds-docs-item{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 12px;margin:0 0 4px -12px;border-radius:4px;color:#5c6c5a;text-decoration:none}.ds-docs-item:hover{color:var(--brand-ink,#153d31);background:#e2eada;filter:brightness(.97)}.ds-docs-item[aria-current]{color:var(--brand-ink,#153d31);background:#dbe7d2;font-weight:500}.ds-docs-item:focus-visible{outline:2px solid #387653;outline-offset:4px;}.ds-docs-item>svg{flex:none}"
    },
    {
      "name": "Account access modes",
      "kind": "custom",
      "refersTo": "auth-mode-tab",
      "description": "The selected Sign in state of the permanent account-mode tabs. The application owns tab switching, keyboard behavior, and provider availability.",
      "html": "<div class=\"ds-auth-tabs\" role=\"tablist\" aria-label=\"Account access\"><button class=\"ds-auth-tab\" id=\"ds-sign-in-tab\" role=\"tab\" aria-selected=\"true\" aria-controls=\"ds-auth-panel\" tabindex=\"0\">Sign in</button><button class=\"ds-auth-tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"ds-auth-panel\" tabindex=\"-1\">Create account</button></div><div class=\"ds-auth-intro\" id=\"ds-auth-panel\" role=\"tabpanel\" aria-labelledby=\"ds-sign-in-tab\"><h1>Welcome to Aftermark</h1><p>Sign in to your workspace and pick up the evidence.</p></div>",
      "css": ".ds-auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;background:#edf2e8;border-radius:5px;margin-bottom:27px;font:400 13px/1.5 \"Work Sans\",sans-serif}.ds-auth-tab{width:auto;min-height:38px;padding:8px 12px;border:0;border-radius:3px;background:transparent;color:#5b6a55;font:inherit;cursor:pointer}.ds-auth-tab[aria-selected=\"true\"]{background:#fff;color:var(--brand-ink,#153d31);font-weight:500}.ds-auth-tab:hover{filter:brightness(.97)}.ds-auth-tab:focus-visible{outline:2px solid #387653;outline-offset:4px}.ds-auth-tab:active{transform:translateY(1px)}@media(max-width:600px){.ds-auth-tabs{margin-bottom:26px}}.ds-auth-intro{color:var(--brand-ink,#153d31);font:400 14px/1.7 \"Work Sans\",sans-serif}.ds-auth-intro>h1{margin:0;font-size:25px;font-weight:500;line-height:1.25;letter-spacing:-.035em}.ds-auth-intro>p{margin:15px 0 27px;color:var(--muted,#5b685f)}"
    },
    {
      "name": "Outcome record",
      "kind": "card",
      "refersTo": "outcome-record",
      "description": "The integrated hero's labeled example, rendered in its default unknown state. The application owns observation changes and the corresponding outcome and CI result.",
      "html": "<section class=\"ds-record\" aria-label=\"Example outcome record\"><header class=\"ds-record-toolbar\"><span class=\"ds-record-title\"><svg viewBox=\"0 0 32 32\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 27 15.3 4h6.3L9.3 27H3Z\" fill=\"currentColor\"/><path d=\"m18.5 14.8 6.4 12.2H31L21.6 9.2l-3.1 5.6Z\" fill=\"currentColor\"/><path d=\"M13 23.2h9.8l-2.5-4.8h-4.7L13 23.2Z\" fill=\"currentColor\"/></svg> Outcome record</span><span class=\"ds-record-example\">Example</span><span class=\"ds-record-badge\"><span class=\"ds-record-dot\"></span>unknown</span></header><div class=\"ds-record-heading\"><div><span class=\"ds-record-scope\">Support workflow / issue creation</span><h3>Leave the support issue open</h3></div><span class=\"ds-record-id\">run_7a82e9</span></div><div class=\"ds-record-columns\"><div class=\"ds-record-claim\"><span class=\"ds-record-label\">What the agent said</span><blockquote>“I created the support issue and left it open.”</blockquote><div class=\"ds-record-reported\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>Reported tool result<strong>success: true</strong></span><span class=\"ds-record-source\">Agent trace</span></div><p class=\"ds-record-caution\">A reported response does not establish the external outcome.</p></div><div class=\"ds-record-observation\"><span class=\"ds-record-label\">What the system recorded</span><div class=\"ds-record-expected\"><span>Expected state</span><strong><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4\"/><path d=\"M9 18c-4.51 2-5-2-7-2\"/></svg> Issue #42 · open</strong></div><label class=\"ds-record-field\">Independent observation<select><option selected>No independent receipt</option><option>Receipt observed: open</option><option>Receipt observed: closed</option></select></label><div class=\"ds-record-answer\" role=\"status\"><span class=\"ds-record-symbol\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/></svg></span><div><strong>Completion remains unknown</strong><p>The record needs independent evidence.</p></div></div></div></div><footer class=\"ds-record-footer\"><span><span class=\"ds-record-completed-dot\"></span>Execution completed</span><span>Outcome unknown</span><span>Illustrative receipt · no live provider query</span></footer></section>",
      "css": ".ds-record{width:100%;overflow:hidden;border-radius:8px;background:#fff;color:var(--text,#24312b);font:400 14px/1.5 \"Work Sans\",sans-serif}.ds-record-toolbar{display:flex;align-items:center;gap:14px;min-height:52px;padding:13px 20px;border-bottom:1px solid #e9ede5;background:#f5f7f2;font-size:13px}.ds-record-title{display:inline-flex;align-items:center;gap:11px;font-weight:500}.ds-record-title>svg{width:21px;height:21px;flex:none;color:var(--brand-ink,#153d31)}.ds-record-example{margin-left:auto;color:var(--muted,#5b685f);font-size:12px}.ds-record-badge{display:inline-flex;align-items:center;gap:5px;flex:none;white-space:nowrap;padding:2px 7px;border-radius:4px;background:#f5edda;color:#7c5b18;font-size:11px;font-weight:500;line-height:1.5;text-transform:capitalize}.ds-record-dot{width:4px;height:4px;border-radius:50%;background:currentColor}.ds-record-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 22px}.ds-record-scope{display:block;margin-bottom:10px;color:var(--muted,#5b685f);font-size:12px}.ds-record-heading h3{margin:0;font-size:18px;font-weight:500;letter-spacing:-.025em}.ds-record-id{color:var(--muted,#5b685f);font-size:12px;font-variant-numeric:tabular-nums}.ds-record-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;padding:0 20px 22px}.ds-record-claim{display:flex;flex-direction:column;padding:20px;border-radius:4px;background:#f4f7f1}.ds-record-label{display:block;margin-bottom:16px;color:var(--muted,#5b685f);font-size:12px}.ds-record-claim blockquote{max-width:26ch;margin:2px 0 23px;font-size:22px;line-height:1.4;letter-spacing:-.025em}.ds-record-reported{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:auto;font-size:12px}.ds-record-reported>svg{color:#53694c;flex:none}.ds-record-reported strong{display:block;margin-top:5px;font-size:12px;font-weight:400}.ds-record-source{margin-left:28px;padding:3px 7px;border-radius:4px;background:#edf1e8;color:#52634e;font-size:11px;line-height:1.4;white-space:nowrap;flex:none}.ds-record-caution{max-width:40ch;margin:20px 0 0;color:var(--muted,#5b685f);font-size:11px;line-height:1.6}.ds-record-observation{padding-top:20px}.ds-record-expected{display:block;margin-bottom:20px;font-size:13px}.ds-record-expected>span{color:var(--muted,#5b685f)}.ds-record-expected strong{display:flex;align-items:center;gap:8px;margin-top:8px;font-weight:500}.ds-record-field{display:grid;gap:7px;margin-bottom:20px;font-size:12px;font-weight:500}.ds-record-field>select{width:100%;min-height:42px;padding:7px 10px;border:1px solid #cdd6c9;border-radius:4px;background:var(--surface,#fff);color:var(--text,#24312b);font:400 13px/1.5 \"Work Sans\",sans-serif}.ds-record-field>select:focus-visible{outline:2px solid #387653;outline-offset:4px}.ds-record-answer{display:flex;align-items:flex-start;gap:10px;min-height:96px;padding:15px 12px;border-radius:4px;background:#f5f2e8}.ds-record-symbol{display:inline-flex;margin-top:1px;color:#8a7336}.ds-record-answer strong{font-size:13px;font-weight:500}.ds-record-answer p{margin:7px 0 0;color:#626047;font-size:12px;line-height:1.6}.ds-record-footer{display:flex;flex-wrap:wrap;gap:12px 22px;padding:15px 22px;border-top:1px solid #e9ede5;color:var(--muted,#5b685f);font-size:11px}.ds-record-footer>span{display:inline-flex;align-items:center;gap:7px}.ds-record-footer>span:last-child{width:100%;margin-left:0}.ds-record-completed-dot{width:5px;height:5px;border-radius:50%;background:#558366}@media(max-width:1100px){.ds-record-columns{display:block}.ds-record-claim{padding:17px}.ds-record-claim blockquote{font-size:19px;margin-bottom:17px}.ds-record-caution,.ds-record-source,.ds-record-observation>.ds-record-label{display:none}.ds-record-reported{flex-wrap:nowrap}.ds-record-expected{display:flex;justify-content:space-between;align-items:center;gap:12px}.ds-record-expected strong{margin-top:0}}@media(max-width:900px){.ds-record-columns{display:grid}.ds-record-claim{padding:20px}.ds-record-claim blockquote{font-size:22px}.ds-record-caution{display:block}}@media(max-width:600px){.ds-record{border-radius:5px}.ds-record-toolbar{flex-wrap:wrap;gap:12px;padding:12px 16px}.ds-record-title{font-size:12px}.ds-record-example{order:3;margin-left:auto;font-size:11px}.ds-record-heading{display:block;padding:19px 16px}.ds-record-scope,.ds-record-id{display:none}.ds-record-columns{display:block;padding:0 16px 18px}.ds-record-claim{padding:17px}.ds-record-claim>.ds-record-label{margin-bottom:10px}.ds-record-claim blockquote{margin:0 0 16px;font-size:19px;line-height:1.4}.ds-record-caution{display:none}.ds-record-reported strong{display:inline;margin:0 0 0 8px}.ds-record-observation{padding:22px 2px 0}.ds-record-answer{min-height:86px}.ds-record-footer{padding:16px 19px;gap:12px}}"
    }
