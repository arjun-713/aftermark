        "purpose": "Quiet row hover background changes."
      },
      {
        "name": "action-arrow",
        "value": "220ms cubic-bezier(0.22, 1, 0.36, 1)",
        "purpose": "Small public action arrows move 2px right and 2px up."
      },
      {
        "name": "opening-lines",
        "value": "0.85s power4.out",
        "purpose": "A 105% masked line rise with 0.1s stagger, only without a reduced-motion preference."
      },
      {
        "name": "opening-context",
        "value": "0.65s power3.out",
        "purpose": "18px travel, 0.25 starting opacity, 0.18s delay, and 0.08s stagger; final inline properties clear."
      },
      {
        "name": "section-reveal",
        "value": "0.55s / 0.7s power3.out",
        "purpose": "18px or 26px section travel, once at top 94%; final inline properties clear."
      },
      {
        "name": "evidence-settle",
        "value": "22px to -12px; ease none",
        "purpose": "Scroll-linked evidence travel from top bottom to bottom top, scrubbed through the integrated public hero."
      },
      {
        "name": "reduced-motion",
        "value": "animation: none; transition: none; scroll-behavior: auto",
        "purpose": "The CSS preference override and GSAP matchMedia gate keep all content at its complete final state."
      }
